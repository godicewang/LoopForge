{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "confidence",
    "summary",
    "cells",
    "visualGates",
    "materialFindings",
    "requiredChanges"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "verdict": { "type": "string", "enum": ["pass", "veto"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "candidatePreservesPrimaryTask", "candidateHasVisibleClipping", "candidateHierarchyPasses", "finding"],
        "properties": {
          "id": { "type": "string", "enum": ["standard-expanded", "standard-narrow", "accessibility-expanded", "accessibility-narrow"] },
          "candidatePreservesPrimaryTask": { "type": "boolean" },
          "candidateHasVisibleClipping": { "type": "boolean" },
          "candidateHierarchyPasses": { "type": "boolean" },
          "finding": { "type": "string", "minLength": 1 }
        }
      }
    },
    "visualGates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "reason"],
        "properties": {
          "id": { "type": "string", "enum": ["H-04", "H-05", "H-06", "H-07", "H-09"] },
          "verdict": { "type": "string", "enum": ["pass", "veto"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "materialFindings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredChanges": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
